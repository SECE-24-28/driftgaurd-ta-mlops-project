# DriftGuard Core Configuration
DRIFTGUARD_API_URL=http://localhost:8000
DRIFTGUARD_DRIFT_THRESHOLD=0.15
DRIFTGUARD_RETRAIN_WINDOW_DAYS=30
DRIFTGUARD_CANARY_INITIAL_WEIGHT=0.10
DRIFTGUARD_CANARY_STEP_MINUTES=30

# MLflow Server Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=driftguard
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Weights & Biases Configuration
# WANDB_API_KEY= (leave empty to automatically trigger offline mode)
WANDB_PROJECT=driftguard
WANDB_ENTITY=your_wandb_entity

# Prefect Server Configuration
PREFECT_API_URL=http://localhost:4200/api

# Database Metadata Store Configuration
POSTGRES_USER=driftguard
POSTGRES_PASSWORD=driftguard
POSTGRES_DB=driftguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Online Feature Store Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Feast Feature Store Config
FEAST_REPO_PATH=./feature_repo

# Notifications Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/mock_webhook_url

# Governance Configuration
GOVERNANCE_REPORT_OUTPUT_DIR=./reports
